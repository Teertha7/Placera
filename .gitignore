# Placera Root .gitignore

# Environment & Secrets
.env
*.env
!.env.example
*.pem
*.key
*.cer
*.crt

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# IDE & Editors
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Backend Build
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log
backend/uploads/

# Frontend Build
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/coverage/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash.log
infra/terraform/*.tfvars
!infra/terraform/terraform.tfvars.example
infra/terraform/override.tf
infra/terraform/override.tf.json
infra/terraform/*_override.tf
infra/terraform/*_override.tf.json
infra/terraform/.terraform.lock.hcl

# Local volume data
postgres_data/
