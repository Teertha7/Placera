# ========================================================
# Placera Environment Configuration Template
# Copy this file to .env for local overrides (never commit real .env)
# ========================================================

# Application Profiles
SPRING_PROFILES_ACTIVE=dev

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL Database Configuration
POSTGRES_DB=placera_db
POSTGRES_USER=placera_user
POSTGRES_PASSWORD=your_secure_database_password_here

# Security & JWT Configuration (Must be at least 256 bits for HMAC-SHA256)
PLACERA_JWT_SECRET=generate_a_random_secure_hex_or_base64_string_minimum_32_bytes
PLACERA_JWT_ACCESS_EXP=86400000
PLACERA_JWT_REFRESH_EXP=604800000

# Bootstrap Initial Administrator (Created once securely on first run)
PLACERA_ADMIN_EMAIL=admin@placera.edu
PLACERA_ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
PLACERA_ADMIN_FIRSTNAME=Placement
PLACERA_ADMIN_LASTNAME=Dean

# Storage
PLACERA_STORAGE_TYPE=local
PLACERA_UPLOAD_DIR=./uploads/resumes

# Azure Production Deployments (Leave blank for local development)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CONTAINER_REGISTRY=
